PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/zasas_db

# Redis (BullMQ queue & caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=zasas_access_super_secret_key_change_in_production_12345
JWT_REFRESH_SECRET=zasas_refresh_super_secret_key_change_in_production_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 / MinIO Object Storage
STORAGE_PROVIDER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zasas-documents
S3_ACCESS_KEY=zasas_admin
S3_SECRET_KEY=zasas_secret_key
S3_FORCE_PATH_STYLE=true

# OCR Provider (mock, gemini, or vision)
OCR_PROVIDER=gemini_flash
GEMINI_API_KEY=
